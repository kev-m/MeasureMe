## {{ release.title.split('-', 1)[-1] }} ({{release.date}})

{{ section('New Features', release.features) -}}
{{- section('Fixes', release.fixes) -}}
{{- section('Performance improvements', release.performance_improvements) -}}
{{- section('Refactorings', release.refactorings) -}}
{{- section('Docs', release.docs) -}}
{{- section('Others', release.builds+release.ci+release.chore+release.reverts+release.style_changes+release.tests) -}}
{% if release.diff_url %}
Full set of changes: [`{{ release.previous_tag.split('-', 1)[-1] }}...{{ release.tag.split('-', 1)[-1] }}`]({{release.diff_url}})
